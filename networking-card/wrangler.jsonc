{
  // Was wrangler.toml until 2026-08-28. Renamed because wrangler's config
  // discovery lets a wrangler.jsonc ANYWHERE up the tree (the monorepo root
  // has one) beat a wrangler.toml in the cwd — same-type-nearest wins, so
  // this file must be jsonc for local dev to bind DB → dazbeez-networking
  // instead of the root app's dazbeez-submissions.
  "name": "dazbeez-networking-card",
  "compatibility_date": "2024-12-01",
  "pages_build_output_dir": "public",
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "4ce69aa7-efac-4739-8ed1-43c9d1a1db4c",
      "database_name": "dazbeez-networking"
    }
  ]
}
