<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dklan.nfc-heartbeat</string>
    <key>ProgramArguments</key>
    <array>
        <string>bash</string>
        <string>/Users/dklan/projects/work/dazbeez/networking-card/scripts/weekly-heartbeat.sh</string>
        <string>--post</string>
    </array>
    <!-- Monday 09:37 JST-ish local time; off the hour on purpose -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>37</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/nfc-heartbeat.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/nfc-heartbeat.err</string>
</dict>
</plist>
